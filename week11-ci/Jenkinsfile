pipeline {
    agent { label 'controller' }

    environment {
        DEPLOY_HOST_IP = '43.128.154.242'
        DEPLOY_HOST_DOMAIN = '43-128-154-242.sslip.io'
        DEPLOY_USER = 'ubuntu'
    }

    stages {
        // ==================== 阶段 1-3：D2 已冻结 ====================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                dir('week2-express/src') {
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                dir('week2-express/src') {
                    withEnv(['CI=']) {
                        sh 'npm test'
                        // V9 注入（反向证明）
                        sh 'echo "BEGIN OPENSSH PRIVATE KEY"'
                    }
                }
            }
        }

        // ==================== 阶段 4：Deploy ====================
        stage('Deploy') {
            steps {
                script {
                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'jenkins-deploy-key',
                            keyFileVariable: 'DEPLOY_KEYFILE'
                        )
                    ]) {
                        def sshCmd = "ssh -i ${DEPLOY_KEYFILE} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ${DEPLOY_USER}@${DEPLOY_HOST_IP}"
                        sh """
                            ${sshCmd} "deploy ${env.GIT_COMMIT}"
                        """
                    }
                }
            }
        }

        // ==================== 阶段 5：Verify ====================
        stage('Verify') {
            steps {
                script {
                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'jenkins-deploy-key',
                            keyFileVariable: 'DEPLOY_KEYFILE'
                        )
                    ]) {
                        def sshCmd = "ssh -i ${DEPLOY_KEYFILE} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ${DEPLOY_USER}@${DEPLOY_HOST_IP}"

                        sh """
                            ${sshCmd} verify
                        """
                        sh "curl -f https://${DEPLOY_HOST_DOMAIN}/"
                        sh """
                            ${sshCmd} "mark-verified ${env.GIT_COMMIT}"
                        """
                    }
                }
            }
        }

        // ==================== 阶段 6：validate-logs（敏感模式扫描） ====================
        stage('validate-logs') {
            steps {
                script {
                    // P6：阶段开头立即取日志（尚未输出本阶段内容）
                    def logLines = currentBuild.rawBuild.getLog(10000)  // 最多 10000 行，当前日志远小于此上限

                    // --- 诊断开始（临时）---
                    echo "=== DIAG: logLines size = ${logLines.size()}"
                    // 打印前 5 行（截断为 50 字符，防长行）
                    logLines.take(5).eachWithIndex { line, idx ->
                        echo "DIAG line ${idx+1}: ${line.take(50)}"
                    }
                    // 搜索包含 "BEGIN" 的行号（不打印内容）
                    def beginIndices = []
                    logLines.eachWithIndex { line, idx ->
                        if (line.contains('BEGIN')) {
                            beginIndices << (idx+1)
                        }
                    }
                    echo "DIAG: lines containing 'BEGIN': ${beginIndices.join(', ')}"
                    // --- 诊断结束 ---

                    // Q10 冻结的四类敏感模式
                    def patterns = [
                        'RSA_PRIVATE_KEY': 'BEGIN RSA PRIVATE KEY',
                        'OPENSSH_PRIVATE_KEY': 'BEGIN OPENSSH PRIVATE KEY',
                        'DEPLOY_PUBLIC_KEY_FINGERPRINT': 'SHA256:s+6XY7MCTYnsqoWfEiOmyaakDtlRY4A9nH7kMGgiHxE',
                        'DEPLOY_PRIVATE_KEY_FRAGMENT': 'b3BlbnNzaC1rZXktdjE'
                    ]

                    def violations = []

                    logLines.eachWithIndex { line, idx ->
                        def lineNum = idx + 1
                        patterns.each { name, pattern ->
                            if (line.contains(pattern)) {
                                violations << [lineNum: lineNum, pattern: name]
                            }
                        }
                    }

                    if (violations) {
                        def msg = "validate-logs 检测到 ${violations.size()} 条敏感模式命中：\n"
                        violations.take(5).each { v ->
                            msg += "  - 第 ${v.lineNum} 行：${v.pattern}\n"
                        }
                        if (violations.size() > 5) {
                            msg += "  ... 以及 ${violations.size() - 5} 条其他命中"
                        }
                        error(msg)
                    } else {
                        echo "validate-logs: 未发现敏感模式"
                    }
                }
            }
        }
    }

    post {
        always {
            echo "构建日志可于 Jenkins 界面查看（${env.BUILD_URL}console）"
        }
    }
}
