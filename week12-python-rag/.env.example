# W12 D4 实验环境变量模板。
# 用法：复制为 .env 并填入真实值；.env 已被根 .gitignore 忽略（第 9-11 行），不会进入 git。
# 也可以不建 .env，直接在 shell export 同名变量（config.py 先读环境变量）。
#
# DeepSeek API key（W12 D2 验证同源 key 位于 week2-express/src/.env；这里单独放一份 week12 本地副本）
DEEPSEEK_API_KEY=
#
# 可选覆盖；默认 https://api.deepseek.com（DeepSeek 兼容 OpenAI Chat Completions 协议）
DEEPSEEK_BASE_URL=
#
# 可选覆盖；默认 deepseek-chat。模型 ID 拼写以当天官方文档与真实响应为准（bub-reading-report §8 待验证项）
DEEPSEEK_MODEL=
