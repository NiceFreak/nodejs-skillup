{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodejs-skillup.local/week13-rag/evaluation-set-v2.schema.json",
  "title": "W13 technical RAG dev evaluation set (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "eval_version", "contract_status", "corpus_snapshot_id", "split", "items"],
  "properties": {
    "schema_version": {"const": 2},
    "eval_version": {"const": "w13-eval-v2-dev"},
    "contract_status": {"const": "draft"},
    "corpus_snapshot_id": {"type": "string", "pattern": "^technical-[0-9a-f]{12}$"},
    "split": {"const": "dev"},
    "items": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "behavior_type", "query", "expected_branch", "expected_rule_conclusion", "evidence_requirements"],
      "properties": {
        "id": {"type": "string", "pattern": "^w13-v2-dev-[0-9]{2}$"},
        "behavior_type": {"enum": ["document_identity", "retrieval", "context_assembly", "grounding_citation", "abstention_agent_control"]},
        "query": {"type": "string", "minLength": 1},
        "expected_branch": {"enum": ["answered", "abstained"]},
        "expected_rule_conclusion": {"type": "string", "minLength": 1},
      "evidence_requirements": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/source"}, {"$ref": "#/$defs/absence"}, {"$ref": "#/$defs/fixture"}]}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "span_id", "source_path", "line_start", "line_end", "requirement"],
      "properties": {
        "kind": {"const": "source_span"}, "span_id": {"type": "string", "pattern": "^technical/.+#L[0-9]+-L[0-9]+$"},
        "source_path": {"type": "string", "minLength": 1}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}, "requirement": {"type": "string", "minLength": 1}
      }
    },
    "absence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "scope", "requirement"],
      "properties": {"kind": {"const": "corpus_absence"}, "scope": {"const": "entire_corpus"}, "requirement": {"type": "string", "minLength": 1}}
    }
    ,"fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fixture_id", "observables", "requirement"],
      "properties": {
        "kind": {"const": "diagnostic_fixture"}, "fixture_id": {"type": "string", "minLength": 1},
        "observables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "requirement": {"type": "string", "minLength": 1}
      }
    }
  }
}
