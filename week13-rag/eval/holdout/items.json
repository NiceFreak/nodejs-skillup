    {
      "id": "w13-holdout-direct-answer-01",
      "behavior_type": "direct_answer",
      "query": "每日技术英语口语稿的英文正文目标时长是否约为 1 分钟？",
      "expected_branch": "answered",
      "expected_rule_conclusion": "是。英文正文要求为 120–150 词，目标时长约 1 分钟。",
      "evidence_requirements": [
        {
          "kind": "source_span",
          "span_id": "rules-c0a4b85/DAILY-SPEAKING-PROTOCOL.md#L28-L28",
          "source_path": "documents/DAILY-SPEAKING-PROTOCOL.md",
          "line_start": 28,
          "line_end": 28,
          "requirement": "该来源范围必须同时规定英文正文词数范围和约 1 分钟的目标时长。"
        }
      ]
    },
    {
      "id": "w13-holdout-direct-answer-02",
      "behavior_type": "direct_answer",
      "query": "当日没有适合引用的代码时，每日 AI 工程学习报告是否应省略整个 Code Evidence？",
      "expected_branch": "answered",
      "expected_rule_conclusion": "是。应省略整个 Code Evidence，不得为了满足格式而选择无关样板代码。",
      "evidence_requirements": [
        {
          "kind": "source_span",
          "span_id": "rules-c0a4b85/DAILY-LEARNING-REPORT-PROTOCOL.md#L99-L99",
          "source_path": "documents/DAILY-LEARNING-REPORT-PROTOCOL.md",
          "line_start": 99,
          "line_end": 99,
          "requirement": "该来源范围必须直接规定没有适合引用的代码时省略整个 Code Evidence，且不得选择无关样板代码。"
        }
      ]
    },
    {
      "id": "w13-holdout-cross-document-01",
      "behavior_type": "cross_document",
      "query": "学习展板部署前为什么既要读取 AGENTS.md，又要读取 SHOWCASE-DEPLOY-PROTOCOL.md？两份文件分别约束什么？",
      "expected_branch": "answered",
      "expected_rule_conclusion": "AGENTS.md 约束 AI 的协作角色和实现边界；SHOWCASE-DEPLOY-PROTOCOL.md 约束展板的构建、验证、发布目标和部署权限，并明确要求部署开始前读取 AGENTS.md。",
      "evidence_requirements": [
        {
          "kind": "source_span",
          "span_id": "rules-c0a4b85/AGENTS.md#L1-L18",
          "source_path": "documents/AGENTS.md",
          "line_start": 1,
          "line_end": 18,
          "requirement": "该来源范围必须说明 AGENTS.md 的协作行为、AI 角色与核心实现边界。"
        },
        {
          "kind": "source_span",
          "span_id": "rules-c0a4b85/SHOWCASE-DEPLOY-PROTOCOL.md#L1-L3",
          "source_path": "documents/SHOWCASE-DEPLOY-PROTOCOL.md",
          "line_start": 1,
          "line_end": 3,
          "requirement": "该来源范围必须说明部署规范负责学习展板的通用发布边界。"
