{
  "permissions": {
    "defaultMode": "acceptEdits",
    "ask": [
      "Bash(rm *)",
      "Bash(/bin/rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Read(/week13-rag/eval/holdout/**)",
      "Edit(/week13-rag/eval/holdout/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-content.mjs\""
          }
        ]
      }
    ]
  }
}
